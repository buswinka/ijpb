<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.scijava</groupId>
    <artifactId>pom-scijava</artifactId>
    <version>37.0.0</version>
    <relativePath/>
  </parent>

  <groupId>buswinka.aipipeline</groupId>
  <artifactId>ImageJPipelineAI</artifactId>
  <version>0.1.16</version>

  <name>AI Pipeline Builder</name>
  <description>AI-powered macro generation plugin for Fiji/ImageJ</description>
  <url>https://github.com/buswinka/ijpb</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>Buswinka Research and Engineering LLC</name>
    <url>https://buswinka.com</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>chrisbuswinka</id>
      <name>Chris Buswinka</name>
      <organization>Buswinka Research and Engineering LLC</organization>
      <roles>
        <role>founder</role>
        <role>lead</role>
        <role>developer</role>
      </roles>
    </developer>
  </developers>

  <!-- Required by pom-scijava enforcer; no external contributors or mailing lists at this time -->
  <contributors><contributor><name>N/A</name></contributor></contributors>
  <mailingLists><mailingList><name>N/A</name></mailingList></mailingLists>

  <scm>
    <connection>scm:git:https://github.com/buswinka/ijpb.git</connection>
    <developerConnection>scm:git:git@github.com:buswinka/ijpb.git</developerConnection>
    <url>https://github.com/buswinka/ijpb</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/buswinka/ijpb/issues</url>
  </issueManagement>

  <!-- Required by pom-scijava enforcer -->
  <ciManagement><system>None</system></ciManagement>

  <properties>
    <package-name>buswinka.aipipeline</package-name>
    <license.licenseName>apache_v2</license.licenseName>
    <license.copyrightOwners>Buswinka Research and Engineering LLC</license.copyrightOwners>
    <main-class>buswinka.aipipeline.PipelineBuilder</main-class>
  </properties>

  <build>
    <finalName>ImageJPipelineBuilder</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>deploy-to-fiji</id>
            <phase>install</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <mkdir dir="/Users/chrisbuswinka/Downloads/Fiji/update/plugins/jars"/>
                <copy overwrite="true"
                      file="${project.build.directory}/${project.build.finalName}.jar"
                      tofile="/Users/chrisbuswinka/Downloads/Fiji/update/plugins/jars/${project.build.finalName}.jar"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>debug-build</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>write-debug-build-config</id>
                <phase>generate-sources</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <echo file="${project.build.sourceDirectory}/buswinka/aipipeline/BuildConfig.java">package buswinka.aipipeline;
/** Generated by debug-build profile — do not commit this state. */
public final class BuildConfig {
    public static final boolean DEBUG = true;
    private BuildConfig() {}
}
</echo>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>net.imagej</groupId>
      <artifactId>ij</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.scijava</groupId>
      <artifactId>scijava-common</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>loci</groupId>
      <artifactId>bio-formats_plugins</artifactId>
      <version>8.5.0</version>
      <scope>system</scope>
      <systemPath>/Users/chrisbuswinka/Downloads/Fiji/plugins/bio-formats_plugins-8.5.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>ome</groupId>
      <artifactId>formats-api</artifactId>
      <version>8.5.0</version>
      <scope>system</scope>
      <systemPath>/Users/chrisbuswinka/Downloads/Fiji/jars/formats-api-8.5.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
